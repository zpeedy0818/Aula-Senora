# Copia este archivo a application.yml y pon aqui tus valores locales.
server:
  port: 8082

spring:
  application:
    name: file-service
  datasource:
    url: jdbc:postgresql://<HOST>:<PORT>/<DB>?prepareThreshold=0
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        temp:
          use_jdbc_metadata_defaults: false
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

app:
  upload:
    dir: uploads
  jwt:
    secret: ${JWT_SECRET:mi-secreto-super-seguro-de-32-caracteres}
    expiration-ms: ${JWT_EXPIRATION_MS:86400000}
